# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every variable below is optional; the defaults shown in comments are what the
# code falls back to when the variable is unset.

# ---------------------------------------------------------------- LLM (Ollama)
# Ollama runs locally, so there is no cloud API key anywhere in this project.
# Default: http://127.0.0.1:11434
# From a container use http://host.docker.internal:11434
OLLAMA_BASE_URL=

# ---------------------------------------------------------------- MongoDB
# Either supply a full connection string...
MONGO_URL=
# ...or the parts used to build an Atlas SRV URL. If MONGO_URL contains the
# literal placeholder <db_password>, MONGO_PASS is substituted into it.
MONGO_USER=
MONGO_PASS=
# Used by the docker-compose services. Default: localhost / 27017
MONGO_HOST=
MONGO_PORT=

# ---------------------------------------------------------------- resume parsing
# Skip OCR and PDF layout segmentation for a faster parse on clean PDFs. Default: 0
FAST_PARSE=
# spaCy pipeline used for NER and skill matching. Default: en_core_web_sm
SPACY_MODEL_NAME=
# Optional newline-delimited file of extra skill terms to recognise.
SKILL_VOCAB_PATH=

# ---------------------------------------------------------------- servers
# Default: INFO
LOG_LEVEL=
# run_fastmcp.py only. Defaults: 127.0.0.1 / 8001 / /mcp
MCP_HOST=
MCP_PORT=
MCP_PATH=
# Fetch job data on FastMCP server start. Defaults: 1 / 100 / jobs.json
MCP_FETCH_ON_START=
MCP_FETCH_COUNT=
MCP_FETCH_OUT=
