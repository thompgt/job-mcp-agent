# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# Every variable is optional. An MCP host normally sets these in the `env`
# block of its config rather than in a file; this exists for the API and for
# development. `careercraft info` prints what actually resolved.

# ------------------------------------------------------------ language model
# Ollama runs locally, so there is no cloud API key anywhere in this project.
# Default: http://127.0.0.1:11434 — from a container, host.docker.internal.
# Set to "disabled" to turn generation off entirely; cover letters then come
# back as a brief for the calling model to write from.
OLLAMA_BASE_URL=
# Any model you have pulled. Default: llama3.2:1b
CAREERCRAFT_OLLAMA_MODEL=
# Seconds. Generation on a small local model is slow. Default: 180
CAREERCRAFT_OLLAMA_TIMEOUT=

# ------------------------------------------------------------------- storage
# Where the SQLite database and uploads live.
# Default: the platform user-data directory (see `careercraft info`).
CAREERCRAFT_DATA_DIR=
# Comma-separated roots that parse_resume(path=...) may read from.
# Default: your home directory.
CAREERCRAFT_ALLOWED_PATHS=
# Default: 10485760 (10 MB)
CAREERCRAFT_MAX_UPLOAD_BYTES=

# ------------------------------------------------------------------- parsing
# spaCy pipeline for name detection, used only with the [nlp] extra.
# Default: en_core_web_sm
CAREERCRAFT_SPACY_MODEL=
# Sentence-transformers model, used only with the [embeddings] extra.
# Default: all-MiniLM-L6-v2
CAREERCRAFT_EMBEDDING_MODEL=
# Newline-delimited file of extra skill terms to recognise.
CAREERCRAFT_SKILL_VOCAB_PATH=
# Try OCR when a PDF yields almost no text. Needs the [ocr] extra. Default: 1
CAREERCRAFT_ENABLE_OCR=

# ---------------------------------------------------------------- job source
# Default: https://jobicy.com/api/v2/remote-jobs
CAREERCRAFT_JOBICY_BASE_URL=
# Seconds a cached search stays fresh. Default: 3600
CAREERCRAFT_JOB_CACHE_TTL_SECONDS=

# ----------------------------------------------------------------- transport
# stdio for an MCP host, http to expose a port. Default: stdio
CAREERCRAFT_TRANSPORT=
# Defaults: 127.0.0.1 / 8000 / /mcp
CAREERCRAFT_HOST=
CAREERCRAFT_PORT=
CAREERCRAFT_HTTP_PATH=
# Required to bind anything but loopback. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CAREERCRAFT_AUTH_TOKEN=
# Comma-separated. Default: http://localhost:3000
CAREERCRAFT_CORS_ORIGINS=
# Only set this inside a container network, where the port is not otherwise
# reachable. It permits a non-loopback bind with no token. Default: 0
CAREERCRAFT_ALLOW_UNAUTHENTICATED_BIND=

# Default: INFO
CAREERCRAFT_LOG_LEVEL=
